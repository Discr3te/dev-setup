#!/usr/bin/env bash

yubico_dir=~/.config/Yubico

create_u2f_key() {
  echo "Generating u2f_key..."
  mkdir -p $yubico_dir
  pamu2fcfg >$yubico_dir/u2f_key
  echo "Finished generating key."
}

menu_existing_key() {
  local options=(
    "Do you want to create a new key"
    "Quit"
  )

  PS3="What would you like to do: "
  select choice in "${options[@]}"; do
    case $choice in
    "DELETE the existing u2f_keys and CREATE a new one")
      rm -rf $yubico_dir/u2f_keys
      create_u2f_key
      ;;
    "Quit")
      exit
      ;;
    *)
      echo "Invalid option $REPLY"
      ;;
    esac
  done
}

if [ -f $yubico_dir/u2f_keys ]; then
  clear
  echo "There is already a u2f_keys file."
  menu_existing_key
else
  clear
  echo "u2f_keys has not been generated yet."
  create_u2f_key
  sudo sed -i '2i\auth    sufficient  pam_u2f.so cue' /etc/pam.d/sudo
  sudo sed -i '2i\auth       required   pam_u2f.so cue' /etc/pam.d/su
  sudo sed -i '2i\auth       required   pam_u2f.so cue' /etc/pam.d/su-l
  sudo sed -i '$a auth       required     pam_u2f.so cue' /etc/pam.d/login
  # hyprlock
  sudo sed -i '$ s/^/#/' /etc/pam.d/hyprlock
  sudo sed -i '3i\auth        required    pam_u2f.so cue' /etc/pam.d/hyprlock
  sudo sed -i '3i\auth        required    pam_unix.so cue' /etc/pam.d/hyprlock
fi
