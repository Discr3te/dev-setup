#!/usr/bin/env bash

key_type_auth=auth
key_type_signing=signing
ssh_config="$HOME"/.config/ssh

create_keys() {
  local key_type=$1
  # local username=$2
  local user_email
  user_email=$(git config user.email)
  local keygen_opts=(
    -t ed25519-sk
    -O resident
    -O verify-required
    -O application=ssh:git_"$key_type"
    # -O user=discr3te
    -C "Git $key_type key $user_email"
    -f "$ssh_config/id_ed25519_sk_git_$key_type"
  )
  echo "Creating git $key_type key"
  ssh-keygen "${keygen_opts[@]}"
}

write_allowed_signers() {
  local user_email
  local sign_key_file
  user_email=$(git config user.email)z
  sign_key_file="$ssh_config/id_ed25519_sk_git_$key_type_signing.pub"

  echo "$user_email namespaces=\"git\" $(cat "$sign_key_file")" >>"$ssh_config/allowed_signers"
}

select_choice() {
  local options=(
    "Create new keys"
    "Download existing keys from your hardware key"
    "Quit"
  )
  local new_key_opts=(
    "Create a new git authentication key"
    "Creat a new git signing key"
    "Create both a new git signing key and authentication key"
    "Go Back"
    "Quit"
  )

  clear
  PS3="What would you like to do: "
  select choice in "${options[@]}"; do
    case $choice in
    "Create new keys")
      clear
      PS3="What would you like to do: "
      select choice in "${new_key_opts[@]}"; do
        case $choice in
        "Create a new git authentication key")
          # read -rp "Please enter the username for this account: " username
          clear
          create_keys $key_type_auth
          clear
          printf "%s\n" "Copy this $key_type_auth key into your Git-based platform:"
          cat "$ssh_config/id_ed25519_sk_git_$key_type_auth.pub"
          echo ""
          read -rp "Press ENTER to continue"
          select_choice
          ;;
        "Creat a new git signing key")
          # read -rp "Please enter the username for this account: " username
          clear
          create_keys $key_type_signing
          write_allowed_signers
          clear
          printf "%s\n" "Copy this $key_type_signing key into your Git-based platform:"
          cat "$ssh_config/id_ed25519_sk_git_$key_type_signing.pub"
          echo ""
          read -rp "Press ENTER to continue"
          select_choice
          ;;
        "Create both a new git signing key and authentication key")
          # read -rp "Please enter the username for this account: " username
          clear
          create_keys $key_type_auth
          echo ""
          clear
          create_keys $key_type_signing
          write_allowed_signers
          clear
          printf "%s\n" "Copy this $key_type_auth key into your Git-based platform:"
          cat "$ssh_config/id_ed25519_sk_git_$key_type_auth.pub"
          echo ""
          printf "%s\n" "Copy this $key_type_signing key into your Git-based platform:"
          cat "$ssh_config/id_ed25519_sk_git_$key_type_signing.pub"
          echo ""
          read -rp "Press ENTER to continue"
          select_choice
          ;;
        "Go Back")
          select_choice
          ;;
        Quit)
          exit
          ;;
        *)
          echo "Invalid option $REPLY"
          ;;
        esac
      done
      ;;
    "Download existing keys from your hardware key")
      pushd "$ssh_config" || exit
      ssh-keygen -K
      write_allowed_signers
      popd || exit
      clear
      printf "%s\n" "Your existing keys have successfully been downloaded to: $ssh_config."
      read -rp "Press ENTER to continue"
      select_choice
      ;;
    Quit)
      exit
      ;;
    *)
      echo "Invalid option $REPLY"
      ;;
    esac
  done
}

sudo pacman -Syu --noconfirm --needed git openssh
mkdir -p "$ssh_config"
select_choice
